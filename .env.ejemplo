# -----------------------------------------------------------------------------
# Archivo de ejemplo de variables de entorno.
# Copiar este archivo como ".env" y ajustar los valores segun el equipo.
#   Windows : copy .env.ejemplo .env
#   Linux   : cp .env.ejemplo .env
# -----------------------------------------------------------------------------

# Puerto por el que escucha el servidor
PORT=3000

# Motor de almacenamiento: "archivo" (JSON local, no requiere instalacion)
# o "mongo" (requiere MONGODB_URI). Si se deja vacio se detecta automaticamente.
MOTOR_DATOS=archivo

# Cadena de conexion a MongoDB Atlas o a una instalacion local.
# Debe incluir el nombre de la base de datos antes del signo "?"; de lo contrario
# los datos se guardan en la base por defecto ("test").
# Ejemplo Atlas : mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/autenticacion?retryWrites=true&w=majority
# Ejemplo local : mongodb://127.0.0.1:27017/autenticacion
MONGODB_URI=

# Servidores DNS que usara Node para resolver el registro SRV de Atlas.
# Solo es necesario si al conectar aparece el error "querySrv ECONNREFUSED":
# ese error indica que el cliente DNS interno de Node (c-ares) tomo un servidor
# inalcanzable, aunque el resto del equipo navegue sin problema.
# Dejar vacio para usar el resolutor del sistema operativo.
DNS_SERVIDORES=

# Llave secreta con la que se firma el token JWT (cambiarla en produccion)
JWT_SECRETO=clave_secreta_solo_para_desarrollo_AA5

# Vigencia del token: 2h, 30m, 1d, etc.
JWT_EXPIRACION=2h

# Rondas de cifrado de bcrypt
RONDAS_CIFRADO=10
